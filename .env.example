VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key
VITE_API_BASE=https://bossimclockedin-api.fly.dev
VITE_TOSS_CLIENT_ID=your-toss-client-id
VITE_OG_IMAGE_URL=/og-contract.png

# --- Sentry: Error and Performance Monitoring ---
# Get your DSN from https://sentry.io/settings/
# Leave empty to skip Sentry initialization (no errors thrown)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# Optional: Track release version in Sentry
# VITE_APP_VERSION=1.0.0

# --- OMP: Google Vertex AI Provider ---
# 방식 A: Service Account JSON Key (ADC — Vertex AI 표준)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_VERTEX_LOCATION=us-central1

# 방식 B: API Key (간편용 — Gemini 모델 호출만 가능)
# GOOGLE_CLOUD_API_KEY=your-vertex-api-key
